          "effects": [
            {
              "id": "study-warm",
              "enabled": true,
              "graph": null,
              "params": {},
              "code": "float4 Effect(EffectContext ctx){float4 c=InputUV(0,ctx.uv);c.rgb*=float3(1.5,.55,.25);return c;}"
            }
          ],
          "transition": {
            "enabled": true,
            "id": "transition.wipe",
            "duration": 1,
            "code": "//@param transition_softness float 0.03 0 1 \"Contour du balayage\"\n//@param transition_direction int 0 0 3 \"Direction (droite/gauche/bas/haut)\"\nfloat4 Effect(EffectContext ctx) {\n    float progress = saturate(ctx.transitionProgress);\n    float4 before = InputUV(1, ctx.uv), after = InputUV(0, ctx.uv);\n    if (progress <= 0) return before;\n    if (progress >= 1) return after;\n    float axis = transition_direction < 2 ? ctx.uv.x : ctx.uv.y;\n    if (transition_direction == 1 || transition_direction == 3) axis = 1 - axis;\n    float feather = max(transition_softness, transition_direction < 2 ? ctx.texel.x : ctx.texel.y);\n    float coverage = 1 - smoothstep(progress - feather * 0.5, progress + feather * 0.5, axis);\n    return lerp(before, after, coverage);\n}\n"
          }
        }
      ],
