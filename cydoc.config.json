{
  "name": "ShaderixFrame",
  "version": "0.14.0-alpha.1",
  "defaultLocale": "en",
  "locales": [
    {
      "code": "en",
      "label": "English"
    },
    {
      "code": "fr",
      "label": "Français"
    }
  ],
  "homePage": "welcome",
  "content": "build/cydoc-input/content",
  "assets": "docs/screenshots",
  "out": "build/help",
  "modules": [
    "image"
  ],
  "sources": [
    "sdk",
    "shaders"
  ],
  "sourceIndex": {
    "enabled": true,
    "includeDirs": [
      "sdk",
      "sdk/openfx",
      "shaders"
    ]
  },
  "translationReport": true,
  "aliases": {
    "overview": "welcome",
    "user-manual": "welcome",
    "getting-started": "quickstart",
    "layer-graph": "layers",
    "shader-graph": "shaders",
    "dsp-graph": "dsp"
  }
}
