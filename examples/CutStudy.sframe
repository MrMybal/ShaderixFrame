          "effects": [
            {
              "id": "color",
              "enabled": true,
              "code": "//@param exposure float 0 -5 5 \"Exposition\"\n//@param saturation float 1 0 2 \"Saturation\"\n//@param contrast float 1 0 2 \"Contraste\"\nfloat4 Effect(EffectContext ctx) {\n    float4 c=InputUV(0,ctx.uv);\n    c.rgb*=exp2(exposure);\n    c.rgb=lerp(dot(c.rgb,float3(0.2126,0.7152,0.0722)).xxx,c.rgb,saturation);\n    c.rgb=(c.rgb-0.5)*contrast+0.5;\n    return float4(saturate(c.rgb),c.a);\n}\n",
              "graph": null,
              "params": {
                "exposure": {
                  "value": 0.0,
                  "keys": [
                    {
                      "time": 0,
                      "value": -0.2,
                      "curve": 1,
                      "shape": 0
                    },
                    {
                      "time": 3,
                      "value": 0.2,
                      "curve": 1,
                      "shape": 0
                    }
                  ]
                },
                "saturation": {
                  "value": 1.05,
                  "keys": []
                },
                "contrast": {
                  "value": 1,
                  "keys": []
                }
              }
            },
            {
              "id": "film-grain",
              "enabled": true,
              "code": "//@param amount float 0.06 0 0.3 \"Grain\"\nfloat4 Effect(EffectContext ctx) {\n    float4 c=InputUV(0,ctx.uv);\n    float n=frac(sin(dot(ctx.px,float2(12.9898,78.233))+ctx.frame*37.12)*43758.5453)-0.5;\n    return float4(saturate(c.rgb+n*amount),c.a);\n}\n",
              "graph": null,
              "params": {
                "amount": {
                  "value": 0.025,
                  "keys": []
                }
              }
            }
