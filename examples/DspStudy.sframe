                    {
                      "time": 12,
                      "value": 0.3,
                      "curve": 1,
                      "shape": 0
                    }
                  ]
                },
                "saturation": {
                  "value": 1.05,
                  "keys": []
                },
                "contrast": {
                  "value": 1,
                  "keys": []
                }
              }
            },
            {
              "id": "film-grain",
              "enabled": true,
              "code": "//@param amount float 0.06 0 0.3 \"Grain\"\nfloat4 Effect(EffectContext ctx) {\n    float4 c=InputUV(0,ctx.uv);\n    float n=frac(sin(dot(ctx.px,float2(12.9898,78.233))+ctx.frame*37.12)*43758.5453)-0.5;\n    return float4(saturate(c.rgb+n*amount),c.a);\n}\n",
              "graph": null,
              "params": {
                "amount": {
                  "value": 0.025,
                  "keys": []
                }
